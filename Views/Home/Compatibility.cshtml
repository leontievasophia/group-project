@{
    ViewData["Title"] = "Сумісність";
    Layout = null;
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Сумісність</title>

    <link rel="stylesheet" href="/css/styles.css" />

    <style>
        body {
            margin: 0;
            min-height: 100vh;
            background-image: url('/assets/background.png');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            font-family: Georgia, serif;
        }

        .compatibility-main {
            text-align: center;
            color: #f6e8b1;
            padding-top: 45px;
        }

        .compatibility-title {
            font-size: 52px;
            margin-bottom: 15px;
        }

        .compatibility-subtitle {
            font-size: 24px;
            margin-bottom: 35px;
        }

        .compatibility-inputs {
            display: flex;
            justify-content: center;
            gap: 90px;
            margin-bottom: 30px;
        }

        .compatibility-input-block {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .compatibility-input-block label {
            font-size: 24px;
        }

        .compatibility-input-block input {
            width: 300px;
            height: 50px;
            border: none;
            background-color: #3b1180;
            color: white;
            font-size: 22px;
            padding-left: 15px;
            outline: none;
        }

        .compatibility-text {
            font-size: 24px;
            margin-bottom: 15px;
        }

        .sun {
    width: 170px;
    cursor: pointer;
    transition: 0.3s;
    margin: 0 auto 20px auto;
    display: block;
}
        .sun:hover {
            transform: scale(1.08);
        }

        .result {
            width: 480px;
            margin: 0 auto;
            background-color: #3b1180;
            border-radius: 25px;
            padding: 20px;
            font-size: 32px;
            font-weight: bold;
            color: #f6d24a;
        }
    </style>
</head>

<body>
    <header class="header-page">
        <div class="container header-container">

            <a asp-controller="Home" asp-action="Index" class="logo">
                MysticHub
            </a>

            <nav class="nav">
                <ul class="nav-list">

                    <li>
                        <a asp-controller="Home" asp-action="Index" class="nav-link">
                            Головна
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Home" asp-action="Horoscope" class="nav-link">
                            Гороскоп
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Home" asp-action="Compatibility" class="nav-link current">
                            Сумісність
                        </a>
                    </li>

                </ul>
            </nav>

        </div>
    </header>

    <main class="compatibility-main">

        <h1 class="compatibility-title">
            Дізнайся сумісність ваших імен
        </h1>

        <p class="compatibility-subtitle">
            Введіть два імені та відкрийте, наскільки ви підходите одне одному
        </p>

        <div class="compatibility-inputs">

            <div class="compatibility-input-block">
                <label>Введіть ім'я</label>
                <input type="text" id="firstName">
            </div>

            <div class="compatibility-input-block">
                <label>Введіть ім'я</label>
                <input type="text" id="secondName">
            </div>

        </div>

        <p class="compatibility-text">
            Тисни на сонце і дізнаєшся сумісність
        </p>

        <img src="/assets/sun.png" class="sun" alt="Сонце">

        <div class="result" id="resultBox">
            Ваша сумісність: ?
        </div>

    </main>

    <script>
        function calculateCompatibility() {
            let firstName = document.getElementById("firstName").value.trim();
            let secondName = document.getElementById("secondName").value.trim();
            let resultBox = document.getElementById("resultBox");

            if (firstName === "" || secondName === "") {
                resultBox.innerHTML = "Введіть два імені";
                return;
            }

            let sum = 0;
            let names = (firstName + secondName).toLowerCase();

            for (let i = 0; i < names.length; i++) {
                sum += names.charCodeAt(i);
            }

            let percent = (sum % 51) + 50;

            resultBox.innerHTML = "Ваша сумісність: " + percent + "%";
        }

        document.querySelector(".sun").addEventListener("click", calculateCompatibility);
    </script>

</body>
</html>