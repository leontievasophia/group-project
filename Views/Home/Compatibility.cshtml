@{
    Layout = null;
    ViewData["Title"] = "Сумісність";
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Сумісність</title>

    <style>
        body {
            margin: 0;
            min-height: 100vh;
            background-image: url('/assets/background.png');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            font-family: Georgia, serif;
            color: #f5e6bd;
        }

        .compatibility-header {
            height: 70px;
            background-color: #d8bd4a;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 80px;
        }

        .compatibility-logo {
            font-size: 30px;
            font-weight: bold;
            color: #061136;
            text-decoration: none;
        }

        .compatibility-nav {
            display: flex;
            gap: 45px;
        }

        .compatibility-nav a {
            color: #061136;
            text-decoration: none;
            font-size: 18px;
            font-weight: bold;
        }

        .compatibility-main {
            text-align: center;
            padding-top: 35px;
        }

        .compatibility-title {
            font-size: 42px;
            margin-bottom: 10px;
            color: #f5e6bd;
        }

        .compatibility-subtitle {
            font-size: 22px;
            margin-bottom: 45px;
            color: #f5e6bd;
        }

        .compatibility-form {
            display: flex;
            justify-content: center;
            gap: 130px;
            margin-bottom: 50px;
        }

        .compatibility-field label {
            display: block;
            font-size: 20px;
            margin-bottom: 10px;
            color: #f2cd4d;
        }

        .compatibility-field input {
            width: 220px;
            height: 45px;
            background-color: #35106f;
            border: none;
            outline: none;
            color: #f2cd4d;
            font-size: 22px;
            text-align: center;
        }

        .compatibility-hint {
            font-size: 18px;
            color: #f5e6bd;
            margin-bottom: 25px;
        }

        .sun-button {
            border: none;
            background: transparent;
            cursor: pointer;
        }

        .sun-button img {
            width: 155px;
            height: auto;
        }

        .result-box {
            display: none;
            margin: 30px auto 0;
            background-color: #35106f;
            color: #f2cd4d;
            width: 420px;
            padding: 25px;
            border-radius: 25px;
            font-size: 28px;
            font-weight: bold;
            box-shadow: 0 0 25px rgba(0, 0, 0, 0.6);
        }
    </style>
</head>

<body>
    <header class="compatibility-header">
        <a asp-controller="Home" asp-action="Index" class="compatibility-logo">
            MysticHub
        </a>

        <nav class="compatibility-nav">
            <a asp-controller="Home" asp-action="Index">Головна</a>
            <a asp-controller="Home" asp-action="Horoscope">Гороскоп</a>
            <a asp-controller="Home" asp-action="Compatibility">Сумісність</a>
        </nav>
    </header>

    <main class="compatibility-main">
        <h1 class="compatibility-title">
            Дізнайся сумісність ваших імен
        </h1>

        <p class="compatibility-subtitle">
            Введіть два імені та відкрийте, наскільки ви підходите одне одному
        </p>

        <div class="compatibility-form">
            <div class="compatibility-field">
                <label for="firstName">Введіть ім'я</label>
                <input type="text" id="firstName" />
            </div>

            <div class="compatibility-field">
                <label for="secondName">Введіть ім'я</label>
                <input type="text" id="secondName" />
            </div>
        </div>

        <p class="compatibility-hint">
            Тисни кнопку і дізнаєшся сумісність
        </p>

        <button class="sun-button" onclick="calculateCompatibility()">
            <img src="/assets/sun.png" alt="Сонце" />
        </button>

        <div id="resultBox" class="result-box"></div>
    </main>

    <script>
        function calculateCompatibility() {
            const firstName = document.getElementById("firstName").value.trim();
            const secondName = document.getElementById("secondName").value.trim();
            const resultBox = document.getElementById("resultBox");

            if (firstName === "" || secondName === "") {
                resultBox.style.display = "block";
                resultBox.innerHTML = "Введіть два імені";
                return;
            }

            let sum = 0;
            const names = (firstName + secondName).toLowerCase();

            for (let i = 0; i < names.length; i++) {
                sum += names.charCodeAt(i);
            }

            const percent = (sum % 51) + 50;

            resultBox.style.display = "block";
            resultBox.innerHTML = "Ваша сумісність: " + percent + "%";
        }
    </script>
</body>
</html>