<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - MysticHub</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/styles.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/group_project.styles.css"
          asp-append-version="true" />
</head>

<body>

    <header class="main-header">

        <a class="logo"
           asp-controller="Home"
           asp-action="Index">
            MysticHub
        </a>

        <nav class="main-nav">

            <a asp-controller="Home"
               asp-action="Index">
                Головна
            </a>

            <a asp-controller="Home"
               asp-action="Horoscope">
                Гороскоп
            </a>

            <a asp-controller="Home"
               asp-action="Compatibility">
                Сумісність
            </a>

        </nav>

    </header>

    <main>
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts",
                              required: false)

</body>
</html>